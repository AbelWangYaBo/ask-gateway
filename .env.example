# ===== 基础 =====
# 默认仅绑定本机；暴露局域网/容器端口映射需显式覆盖为 0.0.0.0
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
DATA_DIR=data

# ===== 数据库（生产用 PostgreSQL；本地开发默认 sqlite，整段留空即可）=====
# 非容器化 PG 部署时显式配置；compose 部署由 compose.yaml 自动拼接，无需在此设置
# DATABASE_URL=postgresql+psycopg://ask:change-me-postgres-password@postgres:5432/ask_gateway

# ===== Docker Compose 专用（仅 compose 部署需要；本地直跑可忽略）=====
POSTGRES_USER=ask
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ask_gateway

# ===== 加密主密钥（上游 Key 加密存储用）=====
# 缺省时自动生成 data/secrets/master_key（0600）并在后续启动复用；
# 生产环境可显式配置（32 字节 base64，uv run python -c "import secrets; print(secrets.token_urlsafe(32))" | base64）
# SECRETS_MASTER_KEY=

# ===== 管理员控制台 =====
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_TTL_HOURS=12

# ===== 上游 DeepSeek Key 池 =====
# Key 在管理台「上游 Key 管理」页维护（AES-GCM 加密入库，增删改即时生效不重启）。
# UPSTREAM_KEYS 仅作首次启动的一次性引导（DB 为空时导入，此后以数据库为准）。
UPSTREAM_KEYS=
UPSTREAM_PROVIDER=deepseek-official
# UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_MODEL=deepseek-flash

# ===== DSH runtime 池 =====
DSH_PROFILE=ask-gateway
# DSH_BIN=
POOL_MIN_SIZE=2
POOL_MAX_SIZE=12
POOL_QUEUE_MAXSIZE=32
POOL_ACQUIRE_TIMEOUT_SECONDS=60
POOL_IDLE_TTL_SECONDS=600
POOL_REAPER_INTERVAL_SECONDS=60
UPSTREAM_CIRCUIT_BREAK_SECONDS=300
SHUTDOWN_GRACE_SECONDS=45
# REQUEST_TIMEOUT_SECONDS=
DSH_INITIALIZE_TIMEOUT_SECONDS=60

# ===== 本平台 Key 默认配额 =====
DEFAULT_RPM=30
DEFAULT_DAILY_BUDGET_CENTS=10000
DEFAULT_CONCURRENCY=4

# ===== 模型白名单（逗号分隔）=====
ALLOWED_MODELS=deepseek-flash,deepseek-v4-pro
