# ===== 基础 =====
LOG_LEVEL=INFO
LOG_JSON=true
DATA_DIR=data

# ===== 数据库（生产用 PostgreSQL；本地开发默认 sqlite 可留空）=====
# DATABASE_URL=postgresql+psycopg://ask:ask@postgres:5432/ask_gateway

# ===== 管理员控制台 =====
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_TTL_HOURS=12

# ===== 上游 DeepSeek Key 池（逗号分隔；明文只走环境变量，不入库不入日志）=====
UPSTREAM_KEYS=sk-your-deepseek-key-1,sk-your-deepseek-key-2
UPSTREAM_PROVIDER=deepseek-official
# UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_MODEL=deepseek-flash

# ===== DSH runtime 池 =====
DSH_PROFILE=ask-gateway
# DSH_BIN=
POOL_MIN_SIZE=2
POOL_MAX_SIZE=12
POOL_QUEUE_MAXSIZE=32
POOL_ACQUIRE_TIMEOUT_SECONDS=60
POOL_IDLE_TTL_SECONDS=600
POOL_REAPER_INTERVAL_SECONDS=60
UPSTREAM_CIRCUIT_BREAK_SECONDS=300
SHUTDOWN_GRACE_SECONDS=45
# REQUEST_TIMEOUT_SECONDS=

# ===== 本平台 Key 默认配额 =====
DEFAULT_RPM=30
DEFAULT_DAILY_BUDGET_CENTS=10000
DEFAULT_CONCURRENCY=4

# ===== 模型白名单（逗号分隔）=====
ALLOWED_MODELS=deepseek-flash,deepseek-v4-pro
